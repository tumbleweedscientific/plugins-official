                "description": "Query ChEMBL bioactive molecules, drug targets, bioactivity assays, and mechanisms."
              },
              "bio-cellguide": {
                "title": "CELLxGENE CellGuide",
                "description": "Explore canonical cell types, marker genes, and single-cell reference ontologies in CELLxGENE."
              },
              "bio-clinical-genomics": {
                "title": "Clinical Genomics",
                "description": "Query ClinGen gene-disease validity, CIViC somatic cancer variants, and Open Targets evidence."
              },
              "bio-clinical-trials": {
                "title": "ClinicalTrials.gov",
                "description": "Search registered clinical studies, eligibility criteria, endpoints, and trial status."
              },
              "bio-biorxiv": {
                "title": "bioRxiv & medRxiv",
                "description": "Search and retrieve life-science and medical preprints from bioRxiv and medRxiv."
              },
              "bio-variants": {
                "title": "Human Variants",
                "description": "Look up population allele frequencies, CADD deleteriousness, ClinVar classifications, and dbSNP rsIDs."
              },
              "bio-drug-regulatory": {
                "title": "FDA Drug Regulatory",
                "description": "Query openFDA drug approvals, prescribing labels, adverse events, and recalls."
              },
              "bio-zinc": {
                "title": "ZINC22",
                "description": "Search ZINC22 purchasable screening compounds, conformers, and vendor catalogs."
              },
              "bio-genes-ontologies": {
                "title": "Genes & Ontologies",
                "description": "Resolve gene annotations, GO terms, OLS ontologies, UniProt entries, and Reactome/KEGG pathways."
              },
              "bio-rna": {
                "title": "RNA Families (Rfam)",
                "description": "Query Rfam non-coding RNA families, covariance models, secondary structures, and alignments."
              },
              "bio-cancer-models": {
                "title": "Cancer Models",
                "description": "Explore DepMap CRISPR/RNAi dependencies, drug sensitivities, and cBioPortal cancer genomics cohorts."
              },
              "bio-chemistry": {
                "title": "Small-Molecule Chemistry",
                "description": "Query PubChem compounds, ChEBI chemical entities, Rhea biochemical reactions, and BindingDB affinities."
              },
              "bio-structures-interactions": {
                "title": "Structures & Interactions",
                "description": "Retrieve experimental and predicted 3D structures from PDB, AlphaFold DB, and EMDB plus IntAct and Complex Portal complexes."
              },
              "bio-literature": {
                "title": "Scholarly Literature",
                "description": "Search OpenAlex scholarly works, citation graphs, authors, and arXiv preprints."
              },
              "bio-protein-annotation": {
                "title": "Protein Annotation",
                "description": "Query InterPro/Pfam protein domains, Human Protein Atlas expression, and STRING interaction networks."
              },
              "bio-research-resources": {
                "title": "Research Resources",
                "description": "Search federal research funding opportunities on Grants.gov and validated antibodies in the Antibody Registry."
              },
              "bio-human-genetics": {
                "title": "Human Genetics",
                "description": "Explore GWAS Catalog associations, eQTL Catalogue summary statistics, and PheWeb phenome-wide associations."
              },
              "bio-expression": {
                "title": "Gene & Tissue Expression",
                "description": "Query GTEx multi-tissue RNA expression and eQTLs alongside PanglaoDB single-cell marker expression."
              },
              "bio-omics-archives": {
                "title": "Omics Archives",
                "description": "Search public multi-omics repositories across NCBI GEO, ArrayExpress, PRIDE proteomics, MetaboLights, and MGnify."
              },
              "bio-biomart": {
                "title": "Ensembl BioMart",
                "description": "Run cross-species gene, transcript, homolog, and identifier batch queries through Ensembl BioMart."
              },
              "bio-genomes": {
                "title": "Genomes (Ensembl & UCSC)",
                "description": "Fetch reference genome sequences, gene models, VEP consequences, and UCSC Genome Browser tracks."
              },
              "bio-regulation": {
                "title": "Gene Regulation",
                "description": "Query ENCODE SCREEN cis-regulatory elements, JASPAR transcription factor motifs, and UniBind TFBS datasets."
              }
            },
            "reviewedBy": "guchen",
            "reviewedAt": "2026-11-17"
          }
