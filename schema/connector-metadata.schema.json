{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dataSources": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      }
    },
    "domains": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      }
    },
    "rateLimit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "terms": {
      "type": "string",
      "format": "uri"
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "cost": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  },
  "additionalProperties": false,
  "$id": "https://schemas.tumbleweedscientific.com/plugins/v2/connector-metadata.schema.json",
  "title": "plugin.json → metadata.tumbleweed.connectors.<server>"
}
