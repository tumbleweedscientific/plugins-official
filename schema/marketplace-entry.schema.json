{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "origin": {
      "type": "string",
      "enum": [
        "builtin",
        "official"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "listed",
        "withdrawn",
        "revoked"
      ]
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "upstream": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "repo",
        "path",
        "sha"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "network": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "credentials": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "api_key",
                  "oauth2"
                ]
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "inject": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "mcp"
                      },
                      "server": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                      }
                    },
                    "required": [
                      "kind",
                      "server"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "egress"
                      },
                      "host": {
                        "type": "string",
                        "minLength": 1
                      },
                      "header": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "host",
                      "header"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "env"
                      },
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]*$"
                      }
                    },
                    "required": [
                      "kind",
                      "name"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "variable": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "required": [
              "id",
              "kind",
              "label",
              "inject"
            ],
            "additionalProperties": false
          }
        },
        "specialists": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "skills": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                }
              },
              "connectors": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                }
              }
            },
            "required": [
              "tools"
            ],
            "additionalProperties": false
          }
        },
        "oauth": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          }
        },
        "connectors": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "maxLength": 300
              },
              "logo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "unavailable": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          }
        },
        "sandboxSkills": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      },
      "required": [
        "reviewedBy",
        "reviewedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "origin",
    "status",
    "review"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.tumbleweedscientific.com/plugins/v2/marketplace-entry.schema.json",
  "title": "marketplace.json → plugins[].metadata.tumbleweed"
}
