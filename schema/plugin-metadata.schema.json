{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "domains": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      }
    },
    "tags": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "maturity": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "experimental"
      ]
    },
    "citations": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "starterPrompts": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "connectors": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "dataSources": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            }
          },
          "domains": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            }
          },
          "homepage": {
            "type": "string",
            "format": "uri"
          },
          "toolLoading": {
            "type": "string",
            "enum": [
              "lazy",
              "eager"
            ]
          },
          "rateLimit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "terms": {
            "type": "string",
            "format": "uri"
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "cost": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://schemas.tumbleweedscientific.com/plugins/v2/plugin-metadata.schema.json",
  "title": "plugin.json → metadata.tumbleweed"
}
