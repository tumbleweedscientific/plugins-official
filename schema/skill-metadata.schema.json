{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "domains": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      }
    },
    "tags": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "maturity": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "experimental"
      ]
    },
    "citations": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "starterPrompts": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "requires": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "enum": [
            "web",
            "sandbox"
          ]
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "resourceClass": {
          "type": "string",
          "enum": [
            "standard",
            "large"
          ]
        },
        "gpu": {
          "type": "boolean"
        },
        "tools": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          }
        },
        "dataSources": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          }
        },
        "models": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          }
        },
        "scienceModels": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          }
        },
        "credentials": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          }
        },
        "longRunning": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      }
    },
    "outputs": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://schemas.tumbleweedscientific.com/plugins/v2/skill-metadata.schema.json",
  "title": "SKILL.md frontmatter → metadata.tumbleweed"
}
