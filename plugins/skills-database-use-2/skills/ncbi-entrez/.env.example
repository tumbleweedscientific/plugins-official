# Environment variables for ncbi-entrez
# Optional: NCBI E-utilities API key (increases rate limit from 3 to 10 req/s)
NCBI_API_KEY=
# Optional: Contact email sent to NCBI E-utilities / BLAST requests
NCBI_EMAIL=
# Optional: NCBI E-utilities API key (alias for NCBI_API_KEY)
NCBI_EUTILS_API_KEY=
# Optional: Tool identifier sent to NCBI E-utilities / BLAST requests
NCBI_TOOL=
