{
  "name": "bio-research",
  "version": "1.2.0",
  "description": "Connect to third-party life-sciences partner services (BioRender, Consensus, Synapse, Wiley Scholar Gateway, Owkin) via OAuth.",
  "author": {
    "name": "Anthropic"
  },
  "license": "Apache-2.0",
  "metadata": {
    "tumbleweed": {
      "domains": [
        "literature",
        "visualization",
        "lab-data",
        "clinical"
      ],
      "maturity": "beta",
      "connectors": {
        "biorender": {
          "domains": [
            "visualization"
          ]
        },
        "consensus": {
          "domains": [
            "literature"
          ]
        },
        "synapse": {
          "dataSources": [
            "synapse"
          ],
          "domains": [
            "lab-data"
          ]
        },
        "wiley": {
          "domains": [
            "literature"
          ]
        },
        "owkin": {
          "domains": [
            "clinical"
          ]
        }
      }
    }
  }
}
