# Environment variables for cheminformatics-cofolding
# Optional: Local directory containing AlphaFold 3 model weights
AF3_MODEL_DIR=
# Optional: Boltz hosted inference API key (optional cloud co-folding)
BOLTZ_API_KEY=
# Optional: Optional Boltz API base URL override
BOLTZ_BASE_URL=
# Optional: OpenProtein API key for remote structure prediction
OPENPROTEIN_API_KEY=
# Optional: OpenProtein account username
OPENPROTEIN_USERNAME=
